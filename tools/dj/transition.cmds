# Stage 1 gate: Mental Atmosphere -> I Feel Love, beat-locked from mixforge's analysis.
# Run from the repo root (DJFORGE_PYTHON and DJFORGE_MIXFORGE must be set):
#   soundcraft-cli script tools/dj/transition.cmds --save OUT.scraft --bounce OUT.wav --start 400 --end 520
# Mental Atmosphere's first downbeat lands on bar 2, so its bar k plays at session bar k + 2;
# I Feel Love comes in on bar 250, an 8-bar phrase of Mental Atmosphere (its bar 248).
event.tempo {"bpm": 137.987}
dj.tempo_ramp {"from_bar": 250, "bars": 32, "from_bpm": 137.987, "to_bpm": 145}
dj.load_warped {"path": "C:/Users/marty/Music/Youtube Loki Playlist/150 - Mental Atmosphere (Midnight Mix).mp3", "at_bar": 1}
dj.load_warped {"path": "C:/Users/marty/Music/Youtube Loki Playlist/069 - I Feel Love (Mixed).mp3", "at_bar": 250}
