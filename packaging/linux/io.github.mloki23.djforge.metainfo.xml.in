<?xml version="1.0" encoding="UTF-8"?>
<!-- AppStream metadata (software centres, Flathub). Template: package.sh and the Flatpak
     manifest substitute @VERSION@ and @DATE@ from Cargo.toml and the build date. -->
<component type="desktop-application">
  <id>io.github.mloki23.djforge</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT OR Apache-2.0</project_license>
  <name>djforge</name>
  <summary>A DJ-first digital audio workstation</summary>
  <developer id="io.github.mloki23">
    <name>the djforge contributors</name>
  </developer>
  <description>
    <p>
      djforge is a DJ-first digital audio workstation: build, prep and play DJ sets with a full
      multitrack editor and mixer underneath. It is based on SoundCraft by the ArtCraft team
      (MIT OR Apache-2.0).
    </p>
    <ul>
      <li>Non-destructive clip editing with fades, playlists, grids and markers</li>
      <li>A mixer with inserts, sends, buses, automation and metering</li>
      <li>Built-in EQ, dynamics, reverb, delay, modulation and instruments</li>
      <li>Imports WAV, AIFF, FLAC, MP3 and MIDI; bounces to disk</li>
      <li>A headless command line and an MCP server for scripting and agents</li>
    </ul>
  </description>
  <launchable type="desktop-id">io.github.mloki23.djforge.desktop</launchable>
  <icon type="stock">io.github.mloki23.djforge</icon>
  <!-- Only url types known to appstream 0.15 (Ubuntu 22.04, where CI validates): no vcs-browser. -->
  <url type="homepage">https://github.com/mloki23/djforge</url>
  <url type="bugtracker">https://github.com/mloki23/djforge/issues</url>
  <url type="help">https://github.com/mloki23/djforge</url>
  <categories>
    <category>AudioVideo</category>
    <category>Audio</category>
  </categories>
  <keywords>
    <keyword>daw</keyword>
    <keyword>audio</keyword>
    <keyword>mixer</keyword>
    <keyword>recording</keyword>
    <keyword>midi</keyword>
  </keywords>
  <branding>
    <color type="primary" scheme_preference="light">#f8d200</color>
    <color type="primary" scheme_preference="dark">#111317</color>
  </branding>
  <requires>
    <display_length compare="ge">760</display_length>
  </requires>
  <supports>
    <control>keyboard</control>
    <control>pointing</control>
  </supports>
  <provides>
    <binary>djforge</binary>
    <mediatype>application/x-soundcraft-session</mediatype>
  </provides>
  <content_rating type="oars-1.1"/>
  <releases>
    <release version="@VERSION@" date="@DATE@"/>
  </releases>
</component>
